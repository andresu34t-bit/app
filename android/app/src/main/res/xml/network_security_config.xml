<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración de seguridad de red.
  Solo permite conexiones HTTPS a los dominios de WhatsApp.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">whatsapp.com</domain>
        <domain includeSubdomains="true">whatsapp.net</domain>
        <domain includeSubdomains="true">fbcdn.net</domain>
    </domain-config>
</network-security-config>
